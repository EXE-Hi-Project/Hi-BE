# ================================
# Hi API - Java Spring Boot
# ================================

# Server
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/hi_app
MONGODB_DB_NAME=hi_app

# JWT (must be at least 32 chars for HS256)
JWT_SECRET=your_jwt_secret_min_32_characters
JWT_EXPIRES_MS=604800000
AUTH_COOKIE_SECURE=false

# CORS
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=https://hilover.space,https://www.hilover.space
DESKTOP_APP_ORIGIN=hi-app://renderer
ALLOW_VERCEL_PREVIEW=false
SWAGGER_PUBLIC=false

# Admin emails (comma-separated)
ADMIN_EMAILS=admin@example.com

# Social OAuth. GOOGLE_CLIENT_ID remains supported for the existing web client.
GOOGLE_CLIENT_ID=your_google_web_client_id
GOOGLE_CLIENT_IDS=your_google_web_client_id,your_google_desktop_client_id
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Resend is required for OTP, reminders, and delivery/bounce tracking
RESEND_API_KEY=re_your_resend_api_key
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret
RESEND_FROM_EMAIL=Hi Lover <no-reply@hilover.space>

# Free map / places source (OpenStreetMap Overpass, no key required)
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_PHOTON_URL=https://photon.komoot.io/api
OSM_CACHE_TTL_HOURS=24
TOMTOM_SEARCH_API_KEY=
TOMTOM_SEARCH_URL=https://api.tomtom.com/search/2/search
VIETMAP_API_KEY=
VIETMAP_AUTOCOMPLETE_URL=https://maps.vietmap.vn/api/autocomplete/v4
VIETMAP_PLACE_URL=https://maps.vietmap.vn/api/place/v4
COUPLE_PLACE_REPORT_HIDE_THRESHOLD=3
COUPLE_PLACE_PHOTO_UPLOAD_ENABLED=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
APP_LOG_LEVEL=INFO

# Cloudinary media storage. Keep API_SECRET server-side only.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=hi

# Gemini remains the current AI provider; configure its key below.

# PayOS Configuration
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
CLIENT_URL=https://hilover.space
PAYMENT_RETURN_ALLOWED_ORIGINS=https://hilover.space,https://www.hilover.space

# Got It Biz API / voucher marketplace
# mock = dev data only; staging/production require API key and RSA issuance work before commerce is enabled.
GOTIT_ENABLED=false
GOTIT_COMMERCE_ENABLED=false
GOTIT_MODE=mock
GOTIT_BASE_URL=https://api-biz-stg.gotit.vn
GOTIT_API_KEY=

# Spring AI - Gemini (get from https://aistudio.google.com/app/apikey)
AI_CHAT_PROVIDER=openai
API_GEMINI=your_google_gemini_api_key
AI_RETRY_MAX_ATTEMPTS=2
